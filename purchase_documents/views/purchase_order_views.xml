<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_factory_shipment" model="ir.ui.view">
        <field name="name">purchase.order.form.factory.shipment</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="custom_purchase.purchase_order_form_factory"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='factory_status']" position="attributes">
                <attribute name="decoration-warning">factory_status in ('transit', 'partial_transit', 'partial')</attribute>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_list_factory_shipment" model="ir.ui.view">
        <field name="name">purchase.order.list.factory.shipment</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="custom_purchase.purchase_order_list_factory"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='factory_status']" position="attributes">
                <attribute name="decoration-warning">factory_status in ('transit', 'partial_transit', 'partial')</attribute>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_kanban_factory_shipment" model="ir.ui.view">
        <field name="name">purchase.order.kanban.factory.shipment</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="custom_purchase.purchase_order_kanban_factory"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='factory_status']" position="attributes">
                <attribute name="decoration-warning">factory_status in ('transit', 'partial_transit', 'partial')</attribute>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_search_factory_shipment" model="ir.ui.view">
        <field name="name">purchase.order.search.factory.shipment</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="custom_purchase.purchase_order_search_factory"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='factory_open']" position="attributes">
                <attribute name="domain">[('factory_status', 'in', ('requested', 'production', 'transit', 'partial_transit', 'partial'))]</attribute>
            </xpath>
            <xpath expr="//filter[@name='factory_transit']" position="attributes">
                <attribute name="domain">[('factory_status', 'in', ('transit', 'partial_transit'))]</attribute>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_form_shipments" model="ir.ui.view">
        <field name="name">purchase.order.form.shipments</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="before">
                <field name="inspection_doc_count" string="Insp." optional="show"
                       invisible="display_type or not inspection_doc_count"/>
                <button name="action_open_inspection_docs" type="object" icon="fa-paperclip"
                        title="Documentos de inspección" invisible="display_type"/>
            </xpath>
            <xpath expr="//notebook/page[@name='purchase_delivery_invoice']" position="before">
                <page string="Envíos" name="solfix_shipments" invisible="not shipment_picking_ids">
                    <field name="shipment_picking_ids" readonly="1">
                        <list decoration-warning="shipment_in_transit" decoration-muted="state == 'cancel'">
                            <field name="name"/>
                            <field name="shipment_mode"/>
                            <field name="shipment_carrier_id"/>
                            <field name="shipment_tracking_ref"/>
                            <field name="shipment_departure_date"/>
                            <field name="shipment_eta"/>
                            <field name="date_done" string="Recibido el" widget="date"/>
                            <field name="shipment_in_transit" column_invisible="1"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_line_inspection_form" model="ir.ui.view">
        <field name="name">purchase.order.line.inspection.form</field>
        <field name="model">purchase.order.line</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form string="Documentos de inspección">
                <group>
                    <field name="order_id" readonly="1"/>
                    <field name="product_id" readonly="1"/>
                    <field name="product_qty" readonly="1"/>
                </group>
                <field name="inspection_attachment_ids" widget="many2many_binary"/>
                <footer>
                    <button string="Guardar" special="save" class="btn-primary"/>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
