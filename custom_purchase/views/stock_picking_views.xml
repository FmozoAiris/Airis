<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_picking_form_shipment" model="ir.ui.view">
        <field name="name">stock.picking.form.shipment</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='operations']" position="after">
                <page string="Envío" name="solfix_shipment" invisible="picking_type_code != 'incoming'">
                    <group>
                        <group>
                            <field name="shipment_mode"/>
                            <field name="shipment_carrier_id"/>
                            <field name="shipment_tracking_ref"/>
                        </group>
                        <group>
                            <field name="shipment_departure_date"/>
                            <field name="shipment_eta"/>
                            <field name="shipment_in_transit" invisible="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="stock_picking_list_shipment" model="ir.ui.view">
        <field name="name">stock.picking.list.shipment</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="shipment_mode" optional="hide"/>
                <field name="shipment_tracking_ref" optional="hide"/>
                <field name="shipment_departure_date" optional="hide"/>
                <field name="shipment_eta" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="stock_picking_search_shipment" model="ir.ui.view">
        <field name="name">stock.picking.search.shipment</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='backorder']" position="after">
                <filter name="shipment_in_transit" string="En tránsito"
                        domain="[('shipment_in_transit', '=', True)]"/>
            </xpath>
            <xpath expr="//search" position="inside">
                <field name="shipment_tracking_ref"/>
            </xpath>
        </field>
    </record>

    <record id="action_purchase_shipments_transit" model="ir.actions.act_window">
        <field name="name">Envíos en tránsito</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('picking_type_code', '=', 'incoming')]</field>
        <field name="context">{'search_default_shipment_in_transit': 1, 'contact_display': 'partner_address'}</field>
    </record>

    <menuitem id="menu_purchase_shipments_transit" name="Envíos en tránsito"
              parent="purchase.menu_procurement_management"
              action="action_purchase_shipments_transit" sequence="8"/>
</odoo>
